          "title": "Option Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "agent_count": {
          "minimum": 0,
          "title": "Agent Count",
          "type": "integer"
        },
        "represented_population": {
          "minimum": 0,
          "title": "Represented Population",
          "type": "number"
        },
        "share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Share",
          "type": "number"
