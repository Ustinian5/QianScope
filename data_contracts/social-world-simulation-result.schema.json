      "type": "object"
    },
    "DecisionQuestion": {
      "additionalProperties": false,
      "description": "A generated or user-supplied question for one deliberation round.",
      "properties": {
        "question_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "round_index": {
          "maximum": 8,
          "minimum": 1,
          "title": "Round Index",
          "type": "integer"
        },
        "prompt": {
          "maxLength": 1000,
          "minLength": 2,
          "title": "Prompt",
          "type": "string"
        },
        "context": {
          "default": "",
          "maxLength": 2000,
          "title": "Context",
          "type": "string"
        },
        "construct": {
          "enum": [
            "reaction",
            "evidence",
            "action",
            "persistence",
            "recommendation"
          ],
          "title": "Construct",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "maxItems": 7,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        }
