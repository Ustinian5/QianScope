          "maximum": 1,
          "minimum": -1,
          "title": "Position",
          "type": "number"
        }
      },
      "required": [
        "option_id",
        "label",
        "position"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "DecisionOptionResult": {
      "additionalProperties": false,
