# FastAPI base URL used by the server-side gateway.
QIANSCOPE_API_URL=http://127.0.0.1:8000

# Legacy ECHO_API_URL remains accepted when QIANSCOPE_API_URL is absent.

# Canonical public origin used for Open Graph and X card URLs.
SITE_URL=http://localhost:3000

# 高德地图 Web JS API 2.0。Key 与安全密钥必须来自同一个 Web 端应用。
# 贵阳底图与实时天气共用该 Web 端应用；服务端地理编码需另建 Web 服务 Key。
# 未设置时，前端会明确降级到仅用于开发验收的本地演示底图。
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=
NEXT_PUBLIC_AMAP_STYLE=amap://styles/whitesmoke
