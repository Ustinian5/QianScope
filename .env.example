# Server-side DeepSeek provider for every user-facing generative operation.
# Keep the key in deployment secrets; never expose it through NEXT_PUBLIC_* variables.
QIANSCOPE_LLM_API_KEY=
QIANSCOPE_LLM_BASE_URL=https://api.deepseek.com
QIANSCOPE_LLM_MODEL=deepseek-v4-flash
QIANSCOPE_LLM_TIMEOUT_SECONDS=90
QIANSCOPE_LLM_MAX_CALLS=100
QIANSCOPE_LLM_REQUIRED=true

QIANSCOPE_ARTIFACT_DIR=artifacts
QIANSCOPE_MIN_SEGMENT_SIZE=30
QIANSCOPE_LOG_LEVEL=INFO

# Existing deployments may keep ECHO_* variables; QianScope reads them as a
# backward-compatible fallback when the corresponding QIANSCOPE_* value is absent.
