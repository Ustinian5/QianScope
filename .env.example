# Optional OpenAI-compatible provider for event semantic compilation.
# Leave blank to use the auditable local fallback and the same statistical runtime.
ECHO_LLM_API_KEY=
ECHO_LLM_BASE_URL=https://api.openai.com/v1
ECHO_LLM_MODEL=
ECHO_LLM_TIMEOUT_SECONDS=45
ECHO_LLM_MAX_CALLS=100

ECHO_ARTIFACT_DIR=artifacts
ECHO_MIN_SEGMENT_SIZE=30
ECHO_LOG_LEVEL=INFO
